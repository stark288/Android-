<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#1a1a1a"
    android:padding="24dp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡️ ANONYMITY TOOLKIT"
        android:textSize="24sp"
        android:textColor="#00ff00"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔴 STOPPED"
        android:textSize="18sp"
        android:textColor="#ff4444"
        android:gravity="center"
        android:layout_marginTop="40dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rotation interval: 1 second"
        android:textColor="#888888"
        android:textSize="12sp"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IP · DNS · MAC · GPS · Trace Wipe"
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="48dp">

        <Button
            android:id="@+id/startButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="▶ START"
            android:textColor="#ffffff"
            android:backgroundTint="#00aa00" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="⏹ STOP"
            android:textColor="#ffffff"
            android:backgroundTint="#aa0000" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠️ Requires root for full functionality"
        android:textColor="#ff8800"
        android:textSize="12sp"
        android:layout_marginTop="40dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0 | ColorOS 16 compatible"
        android:textColor="#444444"
        android:textSize="10sp"
        android:layout_marginTop="8dp" />
</LinearLayout>
